@import "colors.rasi"

/*****----- Configuration -----*****/
configuration {
    show-icons: false;
}

/*****----- Global Properties -----*****/
* {
    font:           "JetBrains Mono Nerd Font 10";
    background:     @surface;
    background-alt: @surface-container-high;
    foreground:     @on-surface;
    selected:       @primary;
    active:         @secondary-container;
    urgent:         @error-container;
}

/*****----- Main Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            550px;
    x-offset:         0px;
    y-offset:         0px;
    padding:          0px;
    border:           0px solid;
    border-radius:    10px;
    border-color:     @selected;
    cursor:           "default";
    background-color: @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:          true;
    spacing:          0px;
    margin:           0px;
    padding:          0px;
    border:           0px solid;
    border-radius:    0px;
    border-color:     @selected;
    background-color: transparent;
    children:         [ "listview", "message" ];
}

/*****----- Listview -----*****/
listview {
    enabled:          true;
    columns:          5;
    lines:            1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          15px;
    margin:           15px;
    background-color: transparent;
    cursor:           "default";
}

/*****----- Elements -----*****/
element {
    enabled:          true;
    padding:          30px 10px;
    border-radius:    10px;
    background-color: @background-alt;
    text-color:       @foreground;
    cursor:           pointer;
    orientation:      vertical;
}

element-text {
    font:             "JetBrains Mono Nerd Font Bold 32";
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    expand:           true;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

/*****----- Message -----*****/
message {
    enabled:          true;
    margin:           0px;
    padding:          15px;
    border-radius:    0px;
    background-color: @background-alt;
    text-color:       @foreground;
}

textbox {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
}
