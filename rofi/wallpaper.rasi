configuration {
    modi:                 "dmenu";
    show-icons:           true;
    kb-element-next:      "";
    kb-element-prev:      "";
    kb-move-char-back:    "";
    kb-move-char-forward: "";
    kb-row-right:         "Right";
    kb-row-left:          "Left";
    kb-accept-entry:      "Return";
}

@import "colors.rasi"

* {
    font:             "Google Sans Flex 11";
    bg:               @surface;
    bg-low:           @surface-container-lowest;
    bg-panel:         @surface-container;
    bg-high:          @surface-container-high;
    fg:               @on-surface;
    fg-muted:         @on-surface-variant;
    accent:           @primary;
    selected-bg:      @primary-container;
    selected-fg:      @on-primary-container;
    border-col:       @outline-variant;
    urgent-col:       @error;
    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            1140px;
    height:           580px;
    border-radius:    24px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg;
    cursor:           "default";
    padding:          0px;
}

mainbox {
    spacing:          0px;
    padding:          20px;
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

/* ── Search bar ─────────────────────────────────────────────────────── */
inputbar {
    spacing:          10px;
    padding:          12px 16px;
    margin:           0px 0px 16px 0px;
    border-radius:    14px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-panel;
    text-color:       @fg;
    children:         [ "textbox-prompt-colon", "entry", "num-filtered-rows", "textbox-slash", "num-rows" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰸉";
    font:             "Google Sans Flex 15";
    vertical-align:   0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color:       @accent;
    margin:           0px 4px 0px 0px;
}

entry {
    expand:            true;
    background-color:  transparent;
    text-color:        @fg;
    cursor:            text;
    placeholder:       "Search wallpapers...";
    placeholder-color: @fg-muted;
    vertical-align:    0.5;
}

num-filtered-rows {
    expand:           false;
    background-color: transparent;
    text-color:       @fg-muted;
    font:             "Google Sans Flex 10";
    vertical-align:   0.5;
}

textbox-slash {
    expand:           false;
    str:              "/";
    background-color: transparent;
    text-color:       @fg-muted;
    font:             "Google Sans Flex 10";
    vertical-align:   0.5;
}

num-rows {
    expand:           false;
    background-color: transparent;
    text-color:       @fg-muted;
    font:             "Google Sans Flex 10";
    vertical-align:   0.5;
}

/* ── Grid ───────────────────────────────────────────────────────────── */
listview {
    columns:          5;
    lines:            1;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          12px;
    background-color: transparent;
    cursor:           "default";
}

/* ── Card ───────────────────────────────────────────────────────────── */
element {
    orientation:      vertical;
    spacing:          0px;
    padding:          6px;
    border-radius:    16px;
    border:           2px solid;
    border-color:     transparent;
    background-color: @bg-panel;
    cursor:           pointer;
}

element normal.normal {
    border-color:     transparent;
    background-color: @bg-panel;
}

element alternate.normal {
    border-color:     transparent;
    background-color: @bg-panel;
}

element selected.normal {
    border-color:     @accent;
    background-color: @selected-bg;
}

element-icon {
    size:             200px;
    border-radius:    12px;
    background-color: @bg-low;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    scale-up:         false;
}

element-text {
    background-color: transparent;
    text-color:       transparent;
    cursor:           inherit;
    font:             "Google Sans Flex 1";
    str:              "";
}

/* ── Status bar ─────────────────────────────────────────────────────── */
message {
    margin:           0px 0px 12px 0px;
    padding:          8px 14px;
    border-radius:    10px;
    background-color: @bg-panel;
    text-color:       @fg-muted;
}

textbox {
    background-color: transparent;
    text-color:       @fg-muted;
    font:             "Google Sans Flex 10";
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          14px;
    border-radius:    12px;
    background-color: @bg-high;
    text-color:       @urgent-col;
}
