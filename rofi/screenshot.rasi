configuration {
    show-icons: false;
}
@import "colors.rasi"
* {
    font:             "JetBrainsMono Nerd Font Mono 11";
    bg:               @surface;
    bg-low:           @surface-container-lowest;
    bg-panel:         @surface-container;
    bg-high:          @surface-container-high;
    fg:               @on-surface;
    fg-muted:         @on-surface-variant;
    accent:           @primary;
    selected-bg:      @primary;
    selected-fg:      @on-primary;
    border-col:       @outline-variant;
    urgent-col:       @error;
    background-color: transparent;
    text-color:       @fg;
}
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            380px;
    border-radius:    30px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg;
    cursor:           "default";
    padding:          0px;
}
mainbox {
    spacing:          0px;
    padding:          16px;
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}
inputbar {
    spacing:          10px;
    padding:          13px 16px;
    margin:           0px 0px 10px 0px;
    border-radius:    204px;
    border:           0px;
    background-color: @bg-panel;
    text-color:       @fg;
    children:         [ "textbox-prompt-colon", "prompt" ];
}
textbox-prompt-colon {
    expand:           false;
    str:              "󰄀";
    font:             "JetBrainsMono Nerd Font Mono 12";
    vertical-align:   0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color:       @accent;
    margin:           0px 4px 0px 0px;
}
prompt {
    background-color: transparent;
    text-color:       @fg;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Mono 12";
}
message {
    margin:           0px 0px 10px 0px;
    background-color: transparent;
}
textbox {
    padding:          9px 14px;
    border-radius:    200px;
    background-color: @bg-panel;
    text-color:       @fg-muted;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    font:             "JetBrainsMono Nerd Font Mono 10";
}
listview {
    columns:          1;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          4px;
    background-color: transparent;
    cursor:           "default";
}
element {
    spacing:          14px;
    padding:          11px 16px;
    border-radius:    204px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}
element normal.normal   { background-color: transparent;           text-color: @fg; }
element normal.urgent   { background-color: transparent;           text-color: @urgent-col; }
element selected.normal { background-color: @primary-container;    text-color: @on-primary-container; }
element selected.urgent { background-color: @urgent-col;           text-color: @bg; }
element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    font:             "JetBrainsMono Nerd Font Mono 10";
}
error-message {
    padding:          14px;
    border-radius:    12px;
    background-color: @bg-high;
    text-color:       @urgent-col;
}
