/*****----- Configuration -----*****/
configuration {
    modi:                "drun,filebrowser,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "  Apps";
    display-filebrowser: "  Files";
    display-window:      "  Windows";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    terminal:            "kitty";
    kb-mode-next:        "Tab";
    kb-mode-previous:    "ISO_Left_Tab";
    kb-element-next:     "";
    kb-element-prev:     "";
}

@import "colors.rasi"

* {
    font: "Google Sans Flex 10";

    bg:           @surface;
    bg-low:       @surface-container-lowest;
    bg-panel:     @surface-container;
    bg-high:      @surface-container-high;

    fg:           @on-surface;
    fg-muted:     @on-surface-variant;

    accent:       @primary;
    selected-bg:  @primary-container;
    selected-fg:  @on-primary-container;

    border-col:   @outline-variant;
    urgent-col:   @error;

    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            860px;
    border-radius:    16px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg;
    cursor:           "default";
}

mainbox {
    spacing:          0px;
    padding:          0px;
    orientation:      horizontal;
    background-color: transparent;
    children:         [ "imagebox", "listbox" ];
}

imagebox {
    padding:          24px;
    background-image: url("~/.config/rofi/current_wallpaper", height);
    background-color: @bg-low;
    border-radius:    16px 0px 0px 16px;
    orientation:      vertical;
    width:            160px;
    children:         [ "inputbar", "dummy", "mode-switcher" ];
}

dummy {
    background-color: transparent;
}

listbox {
    spacing:          10px;
    padding:          18px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "message", "listview" ];
}

inputbar {
    spacing:          8px;
    padding:          11px 14px;
    border-radius:    10px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-panel;
    text-color:       @fg;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰍉 ";
    font:             "Google Sans Flex 13";
    background-color: transparent;
    text-color:       @accent;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    cursor:            text;
    placeholder:       "Search...";
    placeholder-color: @fg-muted;
}

mode-switcher {
    spacing:          6px;
    background-color: transparent;
}

button {
    padding:          9px 12px;
    border-radius:    8px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-panel;
    text-color:       @fg-muted;
    cursor:           pointer;
}

button selected {
    border-color:     @accent;
    background-color: @selected-bg;
    text-color:       @accent;
}

listview {
    columns:       1;
    lines:         9;
    cycle:         true;
    dynamic:       true;
    scrollbar:     false;
    layout:        vertical;
    fixed-height:  true;
    fixed-columns: true;
    spacing:       3px;
    background-color: transparent;
    cursor:        "default";
}

element {
    spacing:          10px;
    padding:          7px 10px;
    border-radius:    8px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}

element normal.normal  { background-color: transparent; text-color: @fg; }
element normal.urgent  { background-color: transparent; text-color: @urgent-col; }
element normal.active  { background-color: transparent; text-color: @accent; }

element selected.normal  { background-color: @selected-bg; text-color: @selected-fg; }
element selected.urgent  { background-color: @selected-bg; text-color: @urgent-col; }
element selected.active  { background-color: @selected-bg; text-color: @accent; }

element-icon {
    background-color: transparent;
    size:             32px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    background-color: transparent;
}

textbox {
    padding:          10px 14px;
    border-radius:    8px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg-panel;
    text-color:       @fg-muted;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          14px;
    border-radius:    12px;
    background-color: @bg-high;
    text-color:       @urgent-col;
}
