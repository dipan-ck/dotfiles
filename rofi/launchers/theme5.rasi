configuration {
    modi:                "drun,filebrowser,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "󰀻";
    display-filebrowser: "󰉋";
    display-window:      "󱂬";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    terminal:            "kitty";
    kb-mode-next:        "Tab";
    kb-mode-previous:    "ISO_Left_Tab";
    kb-element-next:     "";
    kb-element-prev:     "";
}

@import "colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font Mono 10";

    bg:               @surface;
    bg-low:           @surface-container-lowest;
    bg-panel:         @surface-container;
    bg-high:          @surface-container-high;

    fg:               @on-surface;
    fg-muted:         @on-surface-variant;

    accent:           @primary;
    selected-bg:      @primary;
    selected-fg:      @on-primary;

    border-col:       @outline-variant;
    urgent-col:       @error;

    background-color: transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            620px;
    border-radius:    30px;
    border:           1px solid;
    border-color:     @border-col;
    background-color: @bg;
    cursor:           "default";
    padding:          0px;
}

mainbox {
    spacing:          0px;
    padding:          16px;
    orientation:      vertical;
    background-color: transparent;
    children:         [ "inputbar", "mode-switcher", "listbox" ];
}

inputbar {
    spacing:          10px;
    padding:          13px 16px;
    margin:           0px 0px 10px 0px;
    border-radius:    204px;
    border:           0px solid;
    border-color:     @border-col;
    background-color: @bg-panel;
    text-color:       @fg;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "󰍉";
    font:             "JetBrainsMono Nerd Font Mono 16";
    vertical-align:   0.5;
    horizontal-align: 0.5;
    background-color: transparent;
    text-color:       @accent;
    margin:           0px 4px 0px 0px;
}

entry {
    background-color:  transparent;
    text-color:        @fg;
    cursor:            text;
    placeholder:       "Search apps, files, windows...";
    placeholder-color: @fg-muted;
    vertical-align:    0.5;
}

mode-switcher {
    spacing:          6px;
    margin:           0px 0px 10px 0px;
    background-color: transparent;
    orientation:      horizontal;
}

button {
    padding:          7px 0px;
    border-radius:    200px;
    expand:           true;
    background-color: @bg-panel;
    text-color:       @fg-muted;
    cursor:           pointer;
    horizontal-align: 0.5;
    font:             "JetBrainsMono Nerd Font Mono 14";
}

button selected {
    background-color: @primary-container;
    text-color:       @primary;
}

listbox {
    spacing:          0px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "message", "listview" ];
}

listview {
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          2px;
    background-color: transparent;
    cursor:           "default";
}

element {
    spacing:          12px;
    padding:          9px 12px;
    border-radius:    18px;
    background-color: transparent;
    text-color:       @fg;
    cursor:           pointer;
}

element normal.normal    { background-color: transparent;  text-color: @fg; }
element normal.urgent    { background-color: transparent;  text-color: @urgent-col; }
element normal.active    { background-color: transparent;  text-color: @fg; }
element selected.normal  { background-color: @primary-container; text-color: @fg; }
element selected.urgent  { background-color: @selected-bg; text-color: @urgent-col; }
element selected.active  { background-color: @selected-bg; text-color: @selected-fg; }
element alternate.normal { background-color: transparent;  text-color: @fg; }

element-icon {
    background-color: transparent;
    size:             28px;
    cursor:           inherit;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    margin:           0px 0px 6px 0px;
    background-color: transparent;
}

textbox {
    padding:          9px 14px;
    border-radius:    10px;
    background-color: @bg-panel;
    text-color:       @fg-muted;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    font:             "Google Sans Flex 10";
}

error-message {
    padding:          14px;
    border-radius:    12px;
    background-color: @bg-high;
    text-color:       @urgent-col;
}
