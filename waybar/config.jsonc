{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "exclusive": true,
  "gtk-layer-shell": true,
  "modules-left": [
    "custom/app-launcher",
    "hyprland/workspaces",
    "mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/hardware",
    "group/connectivity",
    "group/status-pill",
    "tray"
  ],
  "custom/app-launcher": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Launcher",
    "on-click": "bash ~/.config/rofi/launcher.sh"
  },
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    }
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },
  "clock": {
    "format": "{:%I:%M %p  ·  %a, %d %b}",
    "format-alt": "{:%H:%M  ·  %A, %d %B %Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#6c7086'><b>W{}</b></span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/gpu"
    ]
  },
  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 3,
    "format": "\uee9c {percentage}",
    "on-click": "kitty -e btop"
  },
  "custom/gpu": {
    "exec": "gpu=$(cat /sys/class/hwmon/hwmon*/device/gpu_busy_percent 2>/dev/null | head -1); [ -z \"$gpu\" ] && gpu=0; printf '{\"text\":\"󰾆  %s\",\"tooltip\":\"GPU: %s%%\"}' $gpu $gpu",
    "return-type": "json",
    "interval": 3,
    "format": "{text}",
    "on-click": "kitty -e btop"
  },
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "network"
    ]
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰤭",
    "format-linked": "󰈀",
    "max-length": 20,
    "tooltip-format-wifi": "󰤨  {essid}\n󰈀  {ipaddr}\n󰜮  {signalStrength}%  {frequency}GHz",
    "tooltip-format-ethernet": "󰈀  {ifname}\n󰈀  {ipaddr}\n  via {gwaddr}",
    "tooltip-format-disconnected": "󰤭  Disconnected",
    "on-click": "kitty -e nmtui"
  },
  "group/status-pill": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "pulseaudio",
      "backlight",
      "battery"
    ]
  },
  "bluetooth": {
    "format": "<span size='11pt'>󰂯</span>",
    "format-connected": "<span size='13pt'>󰂱</span>",
    "format-disabled": "<span size='13pt'>󰂲</span>",
    "max-length": 20,
    "tooltip-format": "󰂯  {controller_alias}\n  {controller_address}",
    "tooltip-format-connected": "󰂱  {controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}  {device_address}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias}  {device_address}  󰁹{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "<span size='12pt'>{icon}</span> {volume}",
    "format-muted": "<span size='13pt'>󰝟</span> muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "  {desc}\n  {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "format": "<span size='10pt'>{icon}</span> {percent}",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +2%",
    "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 2%-",
    "tooltip-format": "󰃠  Brightness: {percent}%"
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='10pt'>{icon}</span> {capacity}%",
    "format-charging": "<span size='10pt'>󰂄</span> {capacity}%",
    "format-plugged": "<span size='10pt'>󰚥</span> {capacity}%",
    "format-full": "<span size='10pt'>󰁹</span> {capacity}%",
    "tooltip-format": "  {timeTo}\n  {power}W",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true
  }
}
